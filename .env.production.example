# Copy these names into the deployment platform's secret/environment settings.
DJANGO_DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=crp.example.com
CSRF_TRUSTED_ORIGINS=https://crp.example.com

STATIC_URL=/static/
# Optional absolute paths when the platform requires them:
# STATIC_ROOT=/app/staticfiles
MEDIA_URL=/media/
MAX_LEARNING_MATERIAL_UPLOAD_MB=250
# MEDIA_ROOT must be persistent when USE_S3=False:
# MEDIA_ROOT=/data/media

# Global job aggregation (Adzuna API)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
CRON_SECRET=
JOB_STALE_AFTER_DAYS=7

SECURE_SSL_REDIRECT=True
USE_X_FORWARDED_PROTO=True
SECURE_HSTS_SECONDS=31536000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Recommended for persistent production uploads (Cloudflare R2 or S3):
USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=auto
# AWS_S3_CUSTOM_DOMAIN=
