# Django Settings
DJANGO_DEBUG=True
SECRET_KEY="(^vngu(sn^7*le372+c2(6!qc#1x6e7a9^oj#zx_62jm_4-33="
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
STATIC_URL=/static/
MEDIA_URL=/media/
MAX_LEARNING_MATERIAL_UPLOAD_MB=250

# Global job aggregation (Adzuna API)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Configure the same high-entropy value in Vercel; cron requests use Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
JOB_STALE_AFTER_DAYS=7

# Google OAuth (create an OAuth 2.0 Web application in Google Cloud Console)
# Development callback: http://127.0.0.1:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database (PostgreSQL - for production)
# If not set, SQLite will be used (development)
# DATABASE_URL=postgresql://<user>:<password>@localhost:5432/sahe_crp
# DB_NAME=sahe_crp
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_HOST=localhost
# DB_PORT=5432

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Cloud Storage Configuration (Backblaze B2 S3-compatible)
# Set USE_S3=True to enable cloud storage
# If USE_S3=False or not set, local storage will be used
USE_S3=False

# Backblaze B2 Configuration (if USE_S3=True)
# AWS_ACCESS_KEY_ID=your-b2-key-id
# AWS_SECRET_ACCESS_KEY=your-b2-application-key
# AWS_STORAGE_BUCKET_NAME=sahe-crp-media
# AWS_S3_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
# AWS_S3_REGION_NAME=us-east-005
# AWS_S3_SIGNATURE_VERSION=s3v4
# AWS_S3_ADDRESSING_STYLE=path
# AWS_QUERYSTRING_AUTH=True
# AWS_QUERYSTRING_EXPIRE=3600
# Leave AWS_S3_CUSTOM_DOMAIN unset for a private bucket.
